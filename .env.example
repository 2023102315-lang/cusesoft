# ---------------------------------------------------------------
# CuseSoft Store · configuración local
# Copia este archivo como .env y ajusta los valores reales.
# ---------------------------------------------------------------

# Servidor
PORT=3000
HOST=127.0.0.1
# Debe coincidir con la dirección real de la tienda: los enlaces de
# descarga enviados por correo se construyen con este valor.
APP_URL=http://localhost:3000
STORE_NAME=CuseSoft
SUPPORT_EMAIL=soporte@cusesoft.com
NODE_ENV=development

# Datos de Yape del titular de la cuenta
# (se muestran en el checkout junto al QR)
YAPE_NAME=CuseSoft Store
YAPE_PHONE=999 999 999

# Opcional: ruta pública de la imagen de TU QR oficial de Yape.
# Ejemplo: coloca el archivo en public/assets/yape-qr.png y usa:
# YAPE_QR_IMAGE=/assets/yape-qr.png
# Si se deja vacío se genera un QR informativo con el monto y el pedido.
YAPE_QR_IMAGE=

# Google Sign-In (opcional).
# Crea un OAuth Client ID de tipo "Web application" en
# https://console.cloud.google.com/apis/credentials y agrega
# http://localhost:3000 (y tu dominio) como origen autorizado.
GOOGLE_CLIENT_ID=

# Correo real (opcional). Si no se configura, los correos se
# guardan en server/data/outbox y se muestran en /api/dev/outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CuseSoft Store <no-reply@cusesoft.com>"

# Seguridad
# SESSION_SECRET se genera automáticamente si lo dejas vacío.
SESSION_SECRET=
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60

# Flujo de pago
# true = el pedido queda "en verificación" hasta que lo apruebes manualmente
# desde el panel /admin (requiere ADMIN_TOKEN).
REQUIRE_MANUAL_APPROVAL=false

# Panel de administración (/admin).
# En desarrollo puedes iniciar con credenciales locales (por defecto admin@gmail.com / 123456789).
# En producción define ADMIN_PASSWORD y/o ADMIN_TOKEN con valores seguros.
ADMIN_USER=admin@gmail.com
ADMIN_PASSWORD=123456789
ADMIN_TOKEN=1234

# true = muestra el OTP en pantalla (solo para pruebas)
# DEV_EXPOSE_OTP=false
