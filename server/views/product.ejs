<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#07060d">
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>">
  <link rel="canonical" href="<%= meta.canonicalUrl %>">
  <meta property="og:type" content="product">
  <meta property="og:title" content="<%= meta.title %>">
  <meta property="og:description" content="<%= meta.description %>">
  <meta property="og:image" content="<%= meta.ogImage %>">
  <meta property="og:url" content="<%= meta.canonicalUrl %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <script src="/js/theme-init.js"></script>
  <link rel="stylesheet" href="/css/styles.css">
  <script type="application/ld+json"><%- meta.jsonLd %></script>
</head>
<body>
  <div class="page-glow" aria-hidden="true">
    <span class="glow glow-a"></span>
    <span class="glow glow-b"></span>
  </div>

  <header class="site-header is-scrolled">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="<%= storeName %> Store, ir al inicio">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none"><path d="M20.7 25.2A10.4 10.4 0 1 1 20.7 6.8" stroke="currentColor" stroke-width="4.2" stroke-linecap="round"/><circle cx="23.6" cy="16" r="3.1" fill="currentColor"/></svg>
        </span>
        <span class="brand-text"><%= storeName %><span>Store</span></span>
      </a>
      <nav class="main-nav" aria-label="Navegación principal">
        <a href="/#catalogo">Catálogo</a>
        <a href="/#como-funciona">Cómo funciona</a>
        <a href="/#preguntas">Preguntas</a>
      </nav>
      <div class="header-actions">
        <a class="btn btn-ghost btn-sm" href="/#catalogo">← Volver al catálogo</a>
      </div>
    </div>
  </header>

  <main class="section" style="padding-top:48px;min-height:72vh;">
    <div class="container">
      <article class="detail-grid" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:28px;box-shadow:var(--shadow-md);">
        <div class="detail-media">
          <img src="<%= product.cover %>" alt="<%= product.name %>" style="width:100%;border-radius:var(--radius-md);object-fit:cover;">
        </div>
        <div class="detail-body">
          <span class="eyebrow"><%= product.category %></span>
          <h1 style="margin-top:8px;font-size:clamp(26px,4vw,38px);"><%= product.name %></h1>
          <p class="hero-lead" style="margin-top:12px;"><%= product.description || product.tagline %></p>

          <div style="display:flex;align-items:baseline;gap:12px;margin:20px 0;">
            <strong style="font-size:28px;letter-spacing:-0.03em;">S/ <%= Number(product.price).toFixed(2) %></strong>
            <% if (product.compareAt) { %>
              <span style="color:var(--muted-2);text-decoration:line-through;font-size:16px;">S/ <%= Number(product.compareAt).toFixed(2) %></span>
            <% } %>
            <span class="info-pill"><%= product.fileLabel %></span>
          </div>

          <% if (product.includes && product.includes.length) { %>
            <h2 style="font-size:15px;margin-bottom:10px;">Qué incluye</h2>
            <ul style="display:grid;gap:8px;margin-bottom:24px;color:var(--muted);font-size:14px;">
              <% product.includes.forEach(function(item) { %>
                <li>✓ <%= item %></li>
              <% }); %>
            </ul>
          <% } %>

          <div style="display:flex;gap:12px;flex-wrap:wrap;">
            <a class="btn btn-primary btn-lg" href="/?add=<%= encodeURIComponent(product.id) %>">Agregar al carrito y pagar con Yape</a>
            <a class="btn btn-ghost btn-lg" href="/#catalogo">Ver más productos</a>
          </div>
        </div>
      </article>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-bottom">
      <span>© 2026 <%= storeName %>. Todos los derechos reservados.</span>
      <a href="/sitemap.xml">Sitemap</a>
    </div>
  </footer>
</body>
</html>
